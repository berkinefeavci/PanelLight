diff --git a/Sources/MonitorBar/WriteScheduler.swift b/Sources/MonitorBar/WriteScheduler.swift
index 165ba7e..0b45c6d 100644
--- a/Sources/MonitorBar/WriteScheduler.swift
+++ b/Sources/MonitorBar/WriteScheduler.swift
@@ -50,0 +51,5 @@ func writeOutcome(requested: UInt16, readback: HardwareLevels?) -> WriteOutcome
+
+// One missed probe (monitor asleep or busy) keeps the row that worked; a second in a row means it is really gone.
+func keepsLastKnown(hadHardware: Bool, consecutiveMisses: Int) -> Bool {
+    hadHardware && consecutiveMisses < 2
+}
diff --git a/Tests/MonitorBarTests/MonitorModelTests.swift b/Tests/MonitorBarTests/MonitorModelTests.swift
index ab7aa27..79dbdf7 100644
--- a/Tests/MonitorBarTests/MonitorModelTests.swift
+++ b/Tests/MonitorBarTests/MonitorModelTests.swift
@@ -56,0 +57,18 @@ final class MonitorModelTests: XCTestCase {
+
+    func testBusyMonitorIsRetriedBeforeGivingUp() {
+        var calls = 0
+        let recovered: Int? = retrying(attempts: 3, pause: 0) { calls += 1; return calls == 3 ? 7 : nil }
+        XCTAssertEqual(recovered, 7)
+        XCTAssertEqual(calls, 3)
+
+        calls = 0
+        let dead: Int? = retrying(attempts: 3, pause: 0) { calls += 1; return nil }
+        XCTAssertNil(dead)
+        XCTAssertEqual(calls, 3)
+    }
+
+    func testOneMissedProbeKeepsHardwareControlButTheSecondFallsBack() {
+        XCTAssertTrue(keepsLastKnown(hadHardware: true, consecutiveMisses: 1))
+        XCTAssertFalse(keepsLastKnown(hadHardware: true, consecutiveMisses: 2))
+        XCTAssertFalse(keepsLastKnown(hadHardware: false, consecutiveMisses: 1))
+    }
